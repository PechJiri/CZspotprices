{
      "id": "remaining-day-price-condition",
      "title": {
        "en": "Average price for next X periods is [lowest/highest] within remaining day"
      },
      "hint": {
        "en": "Condition is always true in last possible interval of day, so it is recommended to set time boundaries for flow use"
      },
      "args": [
        {
          "name": "count",
          "type": "number",
          "title": {
            "en": "Number of periods"
          },
          "value": 1
        },
        {
          "name": "interval_type",
          "type": "dropdown",
          "title": {
            "en": "Interval type"
          },
          "values": [
            {
              "id": "hours",
              "title": {
                "en": "hour(s)"
              }
            },
            {
              "id": "intervals",
              "title": {
                "en": "15-minute interval(s)"
              }
            }
          ]
        },
        {
          "name": "condition",
          "type": "dropdown",
          "title": {
            "en": "lowest/highest"
          },
          "values": [
            {
              "id": "lowest",
              "title": {
                "en": "Lowest"
              }
            },
            {
              "id": "highest",
              "title": {
                "en": "Highest"
              }
            }
          ]
        }
      ],
      "titleFormatted": {
        "en": "Average price for next [[count]] [[interval_type]] is [[condition]] within remaining day"
      }
    }